# Database — postgresql:// and postgresql+asyncpg:// are both accepted;
# libpq params like sslmode=require are translated for asyncpg.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/uniroute

# Auth
SECRET_KEY=your-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM via Groq (optional; rule-based triage is used when LLM_API_KEY is unset)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
UNIVERSITY_TIMEZONE=Europe/London
